<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="voice_search"
        android:enabled="true"
        android:icon="@drawable/ic_microphone"
        android:shortcutShortLabel="@string/voice_search_label"
        android:shortcutLongLabel="@string/voice_search_label_long">
        <intent
            android:action="com.meowgi.launcher710.action.VOICE_SEARCH"
            android:targetPackage="${applicationId}"
            android:targetClass="com.meowgi.launcher710.voice.VoiceSearchActivity" />
            <!-- NOTE: ${applicationId} substitution DOES NOT WORK in XML resources.
                 Debug variant will have wrong package. Needs manifestPlaceholders or dynamic shortcuts.
                 BROKEN: Debug APK will target 'com.meowgi.launcher710' instead of '.debug' variant. -->
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
